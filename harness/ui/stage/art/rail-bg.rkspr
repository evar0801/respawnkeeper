# rail-bg.rkspr - IMPORTED, not hand-drawn. 296x600 logical pixels,
# 27 colours, median cut - deterministic, so re-importing the same
# source reproduces this file exactly.
#
# source: harness\ui\stage\draw-bg\lit.0.png
# made by: rk-import-art.ps1 -Width 296 -Colors 36 -Scaling nearest
#
# THE STATUS LIGHT IS ALREADY IN THIS FILE. * (state colour) and + (the same
# colour, dimmed) came from marker colours in the source picture, not from a
# hand pass, so RE-IMPORTING KEEPS THEM. Move them by repainting the art.
#   * <- #FF00FF   (856 pixels)
#   + <- #FF80FF   (1427 pixels)
#
# Whatever is marked here IS the readout: accent while the servers are up,
# magenta the moment one is not. Nothing else in the window may move or glow.

