# bg-near.rkspr - PLACEHOLDER, generated. Foreground silhouette plus the
# floor the keeper stands on. The floor line is '*' = the state colour, so
# the ground under her turns magenta when a server is down.
#
# Regenerated 2026-08-30 for the 128x128 stage (was 80x50). The floor sits
# at row 106; stage.json anchors the keeper there.
@palette
N = #080D18
+ = #1B3350
G = #05080F

@frame idle.0
