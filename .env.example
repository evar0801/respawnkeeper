# respawnkeeper が読む環境変数（この一覧は説明用。プログラムは OS の環境変数を読み、このファイルは読まない）

# 絵の取り込みに使う Python（Pillow 入り）。未設定なら C:\ComfyUI\venv\Scripts\python.exe を探す
RK_ART_PYTHON=
# ComfyUI を置いた場所。絵の下書きを仕上げるスクリプト（harness\ui\stage\rk-rough.ps1 など）だけが使う
COMFYUI_HOME=
# モデルの支払いに API を選んだときだけ使う。profile.json に入るのは「環境変数の名前」で、値はここにも書かない
ANTHROPIC_API_KEY=
# 値は読まない。支払いにサブスクリプションを選んだとき、モデルを呼ぶ子プロセスの環境から消すだけ
ANTHROPIC_AUTH_TOKEN=
# Java を探すときに最初に見る場所（次に既知のインストール先、最後に PATH）。Minecraft を見るときだけ
JAVA_HOME=
# 排他ロックに「誰が持っているか」として書く名前。未設定なら既定の名前
RESPAWNKEEPER_OWNER=
# ファイルのパスを入れると、操作パネルの起動の各段にかかった時間をそこへ書く（調べもの用。ふだんは空）
RK_TRACE=
